{
  "name": "react-leak-guard",
  "version": "0.1.0-alpha",
  "description": "Automatic memory leak prevention for React applications with runtime detection, auto-cleanup, and production diagnostics",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "react",
    "memory-leak",
    "performance",
    "useEffect",
    "cleanup",
    "abort-controller",
    "react-hooks"
  ],
  "author": "Nikita",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.3.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jsdom": "^30.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "ts-jest": "^29.4.13",
    "typescript": "^5.3.0",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TSNikita/react-leak-guard"
  }
}
